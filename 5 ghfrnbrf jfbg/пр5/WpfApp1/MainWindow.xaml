<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="ПР5" Height="450" Width="800" MinHeight="450" MinWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28*"/>
            <ColumnDefinition Width="29*"/>
            <ColumnDefinition Width="42*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="77*"/>
            <RowDefinition Height="342*"/>
        </Grid.RowDefinitions>
        <Button Content="Пуск" Margin="10,10,10,10" Click="Пуск_Click" Grid.ColumnSpan="3"/>
        <ListBox Margin="10,85,10,10" x:Name="Tab" Grid.Row="1" Grid.ColumnSpan="3"/>
        <Label Content="Введите начало отрезка:" Margin="10,10,32,300" Grid.Row="1" FontSize="12"/>
        <Label Content="Введите конец отрезка:" Margin="26,10,14,300" Grid.Row="1" FontSize="12" Grid.Column="1"/>
        <Label Content="Введите шаг:" Margin="44,10,150,300" Grid.Row="1" FontSize="12" Grid.Column="2"/>
        <TextBox x:Name="varA" HorizontalAlignment="Left" Height="33" Margin="10,47,0,0" Grid.Row="1" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="182"/>
        <TextBox x:Name="varB" HorizontalAlignment="Left" Height="33" Margin="26,47,0,0" Grid.Row="1" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="182" Grid.Column="1"/>
        <TextBox x:Name="varH" HorizontalAlignment="Left" Height="33" Margin="44,47,0,0" Grid.Row="1" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="182" Grid.Column="2"/>

    </Grid>
</Window>
